{
  "name": "@nexo/respaldo",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Respaldo cifrado de PostgreSQL y prueba de restauración verificada, con RTO medido y retención (BT-053, BT-058, BT-059)",
  "bin": {
    "nexo-respaldo": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "respaldar": "tsx src/cli.ts respaldar",
    "restaurar": "tsx src/cli.ts restaurar",
    "listar": "tsx src/cli.ts listar"
  },
  "dependencies": {
    "@nexo/console-db": "workspace:*",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.3"
  }
}
