{
  "name": "@nexo/nexo-ctl",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "CLI de Yago Nexo: configuración de la plataforma, validación de contratos, despliegue, promoción, reversa y exportación (BT-015, BT-016, BT-017, BT-049, D-03)",
  "bin": {
    "nexo-ctl": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "ctl": "tsx src/cli.ts",
    "contratos": "tsx src/cli.ts -c ../../nexo-ctl.config.yaml api lint-all"
  },
  "dependencies": {
    "@nexo/wso2-client": "workspace:*",
    "@stoplight/spectral-cli": "^6.17.0",
    "commander": "^15.0.0",
    "fflate": "^0.8.3",
    "undici": "^8.11.2",
    "yaml": "^2.9.1",
    "graphql": "^17.0.2"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.3"
  }
}
