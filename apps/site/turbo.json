{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/console-api/openapi.yaml",
        "$TURBO_ROOT$/deploy/compose/**",
        "$TURBO_ROOT$/tools/lab-bootstrap/src/index.ts",
        "$TURBO_ROOT$/LICENSE",
        "$TURBO_ROOT$/NOTICE",
        "$TURBO_ROOT$/release/evidencias/**"
      ],
      "outputs": ["build/**"]
    }
  }
}
