{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client"],
    "paths": {
      "@nexo/shared/browser": ["../../packages/shared/src/browser.ts"],
      "@nexo/console-api/impacto": ["../console-api/src/modules/catalog-graph.ts"]
    }
  },
  "include": ["src"]
}
