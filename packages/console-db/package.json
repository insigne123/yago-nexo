{
  "name": "@nexo/console-db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Esquema y acceso a datos de la Consola Nexo (PostgreSQL estándar: SUBTEL o Supabase)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "migrate": "node dist/migrate-cli.js"
  },
  "dependencies": {
    "@nexo/shared": "workspace:*",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.15.6",
    "typescript": "5.9.3",
    "vitest": "^5.0.3"
  }
}
