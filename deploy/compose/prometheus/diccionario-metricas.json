  "thirdParty": [
    {
      "name": "jvm_memory_max_bytes",
      "job": "gateway-jvm",
      "usedBy": [
        "tablero «Nexo · Plataforma» · Memoria JVM del gateway"
      ]
    },
    {
      "name": "jvm_memory_used_bytes",
      "job": "gateway-jvm",
      "usedBy": [
        "tablero «Nexo · Plataforma» · Memoria JVM del gateway"
      ]
    },
    {
      "name": "rabbitmq_detailed_queue_consumers",
      "job": "rabbitmq-colas (/metrics/detailed, familia queue_consumer_count)",
      "usedBy": [
        "tablero «Nexo · Plataforma» · Consumidores por cola"
      ]
    },
    {
      "name": "rabbitmq_detailed_queue_messages_ready",
      "job": "rabbitmq-colas (/metrics/detailed, familia queue_coarse_metrics)",
      "usedBy": [
        "regla ColaConMensajesFallidos",
        "tablero «Nexo · Plataforma» · Mensajes en colas"
      ]
    },
    {
      "name": "up",
      "job": "todos los trabajos (Prometheus)",
      "usedBy": [
        "regla ComponenteCaido",
        "tablero «Nexo · Plataforma» · Componentes disponibles (1 = arriba)"
      ]
    },
    {
      "name": "wso2_integration_api_request_count_error_total",
      "job": "nexo-integrator",
      "usedBy": [
        "tablero «Nexo · Plataforma» · Solicitudes al integrador por API"
      ]
    },
    {
      "name": "wso2_integration_api_request_count_total",
      "job": "nexo-integrator",
      "usedBy": [
        "tablero «Nexo · Plataforma» · Solicitudes al integrador por API"
      ]
    }
  ],
  "rules": [
    {
      "group": "nexo-plataforma",
      "alert": "ComponenteCaido",
      "expr": "up == 0",
      "for": "1m",
      "severidad": "S2",
      "resumen": "{{ $labels.job }} en {{ $labels.instance }} no responde",
      "metrics": [
        "up"
      ]
    },
    {
      "group": "nexo-plataforma",
      "alert": "ColaConMensajesFallidos",
      "expr": "sum by (vhost, queue) (rabbitmq_detailed_queue_messages_ready{queue=~\".+[.]dlq\"}) > 0",
      "for": "5m",
      "severidad": "S3",
      "resumen": "La cola de mensajes fallidos {{ $labels.queue }} tiene {{ $value }} mensajes pendientes",
      "metrics": [
        "rabbitmq_detailed_queue_messages_ready"
      ]
    },
    {
      "group": "nexo-gateway",
      "alert": "TasaDeErrorAlta",
      "expr": "100 * sum by (apiName) (rate(nexo_gateway_counter_solicitudes_total{proxyResponseCode=~\"5..\"}[5m])) / clamp_min(sum by (apiName) (rate(nexo_gateway_counter_solicitudes_total[5m])), 1e-9) > 5",
      "for": "5m",
      "severidad": "S2",
      "resumen": "La API {{ $labels.apiName }} tiene más de 5% de errores 5xx",
      "metrics": [
        "nexo_gateway_counter_solicitudes_total"
      ]
    },
    {
      "group": "nexo-gateway",
      "alert": "LatenciaAlta",
      "expr": "histogram_quantile(0.99, sum by (le, apiName) (rate(nexo_gateway_histogram_latencia_ms_bucket[5m]))) > 2000",
      "for": "10m",
      "severidad": "S3",
      "resumen": "La latencia p99 de {{ $labels.apiName }} supera 2 s",
      "metrics": [
        "nexo_gateway_histogram_latencia_ms_bucket"
      ]
    }
  ],
