{
  "routing": {
    "evaluationInterval": "15s",
    "groupBy": [
      "alertname",
      "severidad"
    ],
    "receiver": "consola",
    "webhookUrl": "http://console-api:8090/api/v1/alerts/alertmanager",
    "sendResolved": true,
    "tokenFile": "/run/secrets/nexo_alertas_token"
  },
  "jobs": [
    {
      "job": "prometheus",
      "targets": [
        "localhost:9090"
      ],
      "path": "/metrics"
    },
    {
      "job": "nexo-integrator",
      "targets": [
        "mi:9201"
      ],
      "path": "/metric-service/metrics",
      "componente": "integrator"
    },
    {
      "job": "gateway",
      "targets": [
        "fluent-bit:2021"
      ],
      "path": "/metrics",
      "componente": "gateway"
    },
    {
      "job": "gateway-jvm",
      "targets": [
        "apim:9404"
      ],
      "path": "/metrics",
      "componente": "gateway"
    },
    {
      "job": "fluent-bit",
      "targets": [
        "fluent-bit:2020"
      ],
      "path": "/api/v2/metrics/prometheus",
      "componente": "observabilidad"
    },
    {
      "job": "rabbitmq",
      "targets": [
        "rabbitmq:15692"
      ],
      "path": "/metrics",
      "componente": "colas"
    },
    {
      "job": "rabbitmq-colas",
      "targets": [
        "rabbitmq:15692"
      ],
      "path": "/metrics/detailed",
      "params": {
        "family": [
          "queue_coarse_metrics",
          "queue_consumer_count"
        ]
      },
      "componente": "colas"
    },
    {
      "job": "keycloak",
      "targets": [
        "keycloak:9000"
      ],
      "path": "/metrics",
      "componente": "identidad"
    },
    {
      "job": "backends",
      "targets": [
        "concesiones-v1:7001",
        "concesiones-v2:7001",
        "registro-soap:7001"
      ],
      "path": "/metrics",
      "componente": "backend"
    },
    {
      "job": "nexo-services",
      "targets": [
        "console-api:8090"
      ],
      "path": "/api/v1/metrics",
      "componente": "consola"
    },
    {
      "job": "nexo-motores",
      "targets": [
        "motores:9465"
      ],
      "path": "/metrics",
      "componente": "motores"
    },
    {
      "job": "nexo-division",
      "targets": [
        "nexo-division:9902"
      ],
      "path": "/stats/prometheus",
      "componente": "division"
    }
  ],
  "metrics": [
