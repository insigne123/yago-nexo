 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Gateway · consumo, errores y latencia",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "collapsed": false,
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Solicitudes por segundo",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(nexo_gateway_counter_solicitudes_total[5m]))"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Tasa de error (5xx)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "red",
        "value": 5
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * sum(rate(nexo_gateway_counter_solicitudes_total{proxyResponseCode=~\"5..\"}[5m])) / clamp_min(sum(rate(nexo_gateway_counter_solicitudes_total[5m])), 1e-9)"
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Rechazos de seguridad (401/403)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(nexo_gateway_counter_solicitudes_total{proxyResponseCode=~\"401|403\"}[1h]))"
    }
   ]
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Latencia p95 (ms)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 500
       },
       {
        "color": "red",
        "value": 1000
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
