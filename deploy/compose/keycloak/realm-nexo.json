      "credentials": [{ "type": "password", "value": "Nexo-Lab-2026!", "temporary": false }],
      "groups": ["nexo-operadores"]
    },
    {
      "username": "pedro.auditoria",
      "email": "pedro.auditoria@ejemplo.invalid",
      "firstName": "Pedro",
      "lastName": "Vargas",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "Nexo-Lab-2026!", "temporary": false }],
      "groups": ["nexo-auditores"]
    },
    {
      "username": "consumidor.demo",
      "email": "consumidor.demo@ejemplo.invalid",
      "firstName": "Operador",
      "lastName": "Telecom",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "Nexo-Lab-2026!", "temporary": false }],
      "groups": ["nexo-consumidores"]
    }
  ]
}
